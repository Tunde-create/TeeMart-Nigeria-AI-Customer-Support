    {
      "parameters": {
        "inputText": "={{ $json.email_subject + \"\\n\" + $json.customer_message }}",
        "categories": {
          "categories": [
            {
              "category": "Price Enquiry",
              "description": "Customer enquiries primarily asking about product prices, costs, discounts, promotions, or payment amounts. If a message asks about several topics, choose this category when pricing is the main request."
            },
            {
              "category": "Product Enquiry",
              "description": "Customer enquiries primarily asking about product availability, specifications, features, brands, models, colours, sizes, or product recommendations. Use this category when product information is the main request rather than pricing, ordering, or delivery."
            },
            {
              "category": "Order Placement",
              "description": "Customer messages primarily requesting to place a new order, purchase a product, confirm a purchase, or proceed with checkout. Use this category when the customer clearly intends to buy a product rather than simply asking about its price or availability."
            },
            {
              "category": "Delivery Enquiry",
              "description": "Customer enquiries primarily asking about delivery locations, shipping fees, estimated delivery times, dispatch status, tracking information, or delivery arrangements. Use this category when delivery or shipping is the main concern rather than product pricing, product information, or order placement."
            },
            {
              "category": "Complaint",
              "description": "Customer messages primarily reporting dissatisfaction, damaged or defective products, incorrect orders, missing items, failed payments, delayed deliveries, refund requests, or poor customer service. Classify as Complaint when the customer is reporting a problem or requesting a resolution, even if the message also mentions delivery, pricing, or product information."
            },
            {
              "category": "General Enquiry",
              "description": "Customer messages primarily asking general questions about TeeMart Nigeria, including business location, opening hours, contact information, company policies, or other enquiries that do not fit into Price Enquiry, Product Enquiry, Order Placement, Delivery Enquiry, or Complaint. Use this category only when none of the other five categories is more appropriate."
            }
          ]
        },
        "options": {}
      },
