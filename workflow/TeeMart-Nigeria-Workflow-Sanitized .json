      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a84b345f-9d89-422a-a6a8-b4361921c601",
              "name": "customer_name",
              "value": "={{\n  (\n    ($json.Text || $json.text || $json.snippet || \"\")\n      .match(/\\bmy name is\\s+([A-Za-z]+)/i)?.[1]\n    ||\n    ($json.From || \"\").split(\"<\")[0].trim()\n    ||\n    ($json.From || \"\").match(/<([^>]+)>/)?.[1]\n    ||\n    \"Customer\"\n  ).trim()\n}}",
              "type": "string"
            },
            {
              "id": "7eea331f-5840-407a-8805-7777cdf0570d",
              "name": "customer_email",
              "value": "={{ ($json.From || \"\").match(/<([^>]+)>/)?.[1] || ($json.From || \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "a026eb8c-bee5-4bf8-8cbb-076f9c871e39",
              "name": "email_subject",
              "value": "={{ $json.Subject }}",
              "type": "string"
            },
            {
              "id": "2a18c4e4-09ba-400d-9e5e-fd30b1753957",
              "name": "customer_message",
              "value": "={{ $json.snippet || \"\" }}",
              "type": "string"
            },
            {
              "id": "13c49c1c-8a5d-4845-b817-b59b67074a55",
              "name": "message_id",
              "value": "={{ $json.id }}",
              "type": "string"
            }
          ]
        },
